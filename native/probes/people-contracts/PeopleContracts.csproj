<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../session-client/NativePersonalCommands.cs" Link="Personal/NativePersonalCommands.cs" />
    <Compile Include="../../session-client/NativeCommandException.cs" Link="Personal/NativeCommandException.cs" />
    <Compile Include="../windows-reactor/Features/People/Core/*.cs" Link="Personal/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
