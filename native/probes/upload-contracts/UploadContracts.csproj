<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../session-client/*.cs" Link="Client/%(Filename)%(Extension)" />
    <Compile Include="../identity-client/WindowsProtectedJournal.cs" Link="Client/WindowsProtectedJournal.cs" />
    <Compile Include="../windows-reactor/Features/Uploads/Core/*.cs" Link="Uploads/%(Filename)%(Extension)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
