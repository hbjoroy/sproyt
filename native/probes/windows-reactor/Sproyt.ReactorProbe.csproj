<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Version>0.1.0</Version>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Sproyt.ReactorProbe</AssemblyName>
    <RootNamespace>Sproyt.WindowsProbe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.16" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <!-- Match the preview's analyzers without changing the machine-wide SDK. -->
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="5.9.0" PrivateAssets="all" />
    <Compile Include="../managed/ProbeWorker.cs" Link="Core/ProbeWorker.cs" />
  </ItemGroup>
  <!-- Code-only WinUI still needs the merged application resource index.
       Publish otherwise copies component PRIs but omits this generated PRI. -->
  <Target Name="PublishMergedApplicationPri" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The merged application PRI must be generated before publishing the WinUI probe." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
