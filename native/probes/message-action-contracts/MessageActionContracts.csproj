    <Compile Include="../../session-client/NativeChatClient*.cs" Link="Transport/%(Filename)%(Extension)" />
    <Compile Include="../../session-client/NativeClientWire.cs" Link="Transport/NativeClientWire.cs" />
    <Compile Include="../client-contracts/SyntheticSession.cs" Link="Fixture/SyntheticSession.cs" />
    <Compile Include="../client-contracts/FixtureServer.cs" Link="Fixture/FixtureServer.cs" />
