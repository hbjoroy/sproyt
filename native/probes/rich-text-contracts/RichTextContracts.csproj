<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../session-client/NativeMessageContent.cs" Link="NativeMessageContent.cs" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <Compile Include="../windows-reactor/Features/RichText/NativeRichText.cs" Link="NativeRichText.cs" />
  </ItemGroup>
</Project>
