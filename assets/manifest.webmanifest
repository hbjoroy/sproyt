{
  "id": "/",
  "name": "Sprøyt",
  "short_name": "Sprøyt",
  "description": "Chat for vennekretsar.",
  "lang": "nn",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e8f2ec",
  "theme_color": "#27604a",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title", "text": "text", "url": "url",
      "files": [{ "name": "image", "accept": ["image/jpeg", "image/png", "image/gif", "image/webp", "image/heic", "image/avif", ".jpg", ".jpeg", ".png", ".gif", ".webp", ".heic", ".avif"] }]
    }
  },
  "icons": [
    {
      "src": "/assets/sproyt-wave-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/sproyt-wave-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
