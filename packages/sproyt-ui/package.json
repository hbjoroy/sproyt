{
  "name": "@sproyt/ui", "version": "0.1.1", "type": "module",
  "description": "Editorial application components for React and Vue",
  "files": ["dist", "README.md", "docs"], "sideEffects": ["**/*.css"],
  "exports": {
    "./react": {"types":"./dist/react/index.d.ts","import":"./dist/react/index.js"},
    "./vue": {"types":"./dist/vue/index.d.ts","import":"./dist/vue/index.js"},
    "./styles.css": "./dist/styles.css",
    "./tokens": {"types":"./dist/tokens.d.ts","import":"./dist/tokens.js"}
  },
  "scripts": {
    "build":"tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "dev":"vite --host 127.0.0.1",
    "build:demo":"vite build",
