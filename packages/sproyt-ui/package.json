    "test":"vitest run",
    "pack:frontend":"npm run build && npm pack --pack-destination ../../frontend/vendor"
  },
  "peerDependencies":{"react":">=18 <20","react-dom":">=18 <20","vue":"^3.5.0"},
  "peerDependenciesMeta":{"react":{"optional":true},"react-dom":{"optional":true},"vue":{"optional":true}},
  "devDependencies":{"react":"^19.0.0","react-dom":"^19.0.0","vue":"^3.5.0","typescript":"^5.7.0","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","vite":"^6.0.0","vitest":"^3.0.0","jsdom":"^26.0.0","@testing-library/react":"^16.0.0","@testing-library/vue":"^8.1.0","@testing-library/user-event":"^14.0.0"}
}
